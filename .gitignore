ledger.jsonl
claude_ledger.jsonl
rlm_ledger.jsonl

# --- BrowseComp-Plus: the benchmark asks that questions/answers never appear online in plain text ---
results/rlm_transcripts/e12_*
results/e12_bcp*.jsonl

# --- run bookkeeping ---
*.pid
results/*_log.txt
experiments/scratch/
jev-baselines-bundle.tgz
results/e5c_ckpt_*.npz
